# Copiá este archivo a secretos/.env y completalo. secretos/ está en .gitignore.

# Application ID (un UUID) de tu aplicación en el panel de Enable Banking. No es secreto.
ENABLEBANKING_APP_ID=

# La clave privada .pem que te da Enable Banking al registrar la aplicación. ESA sí es secreta.
# Relativa a secretos/ salvo que pongas una ruta absoluta.
ENABLEBANKING_KEY_PATH=enablebanking.pem

# Tiene que ser EXACTAMENTE la que registraste en la aplicación.
ENABLEBANKING_REDIRECT_URL=https://localhost/
